    {
        "id": "c09fbb0cfe263f6f",
        "type": "function",
        "z": "41f05514e7e9b379",
        "name": "data split",
        "func": "// Se msg.payload já é um objeto:\nlet data = msg.payload;\n\n// Se ainda quiser garantir, pode testar:\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        node.error(\"JSON inválido\", msg);\n        return [null, null];\n    }\n}\n\n// Restaura as quebras de linha no campo imu\nif (data.imu) {\n    data.imu = data.imu.replace(/\\/n/g, '\\n');\n}\n\nlet msg_gps = { payload: data.gps, id: data.id };\nlet msg_imu = { payload: data.imu, id: data.id };\n\nreturn [msg_gps, msg_imu];",
