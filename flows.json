    {
        "id": "7e0ad770be2f7f73",
        "type": "function",
        "z": "41f05514e7e9b379",
        "name": "calculo de variancia",
        "func": "// Verifica se a mensagem de reset foi enviada\nif (msg.payload.reset === true) {\n    flow.set('allDataArrays', null);\n    //node.warn(\"Histórico de variância resetado.\");\n    return null; // Encerra a execução para mensagens de reset\n}\n\n// A partir daqui, a lógica assume que msg.payload é uma string (dados do IMU)\n// Se msg.payload não for uma string, o código irá parar.\nif (typeof msg.payload !== 'string') {\n    node.error(\"Erro: msg.payload não é uma string. Não foi possível calcular a variância.\");\n    return null;\n}\n\n// A variável ID já está sendo capturada do nó anterior\nvar ID = msg.id;\n\n// Assume que msg.payload é uma string com os dados do IMU\nconst fullImuDataString = msg.payload.trim();\n\n// Divide a string pelas leituras de IMU usando o '\\n' como delimitador\nconst individualReadingStrings = fullImuDataString.split(\"\\n\");\n\nconst NUM_VALUES_PER_READING = 9;\nvar messagesToSend = [];\n\nconst maxArraySize = 12;\n\nlet allDataArrays = flow.get('allDataArrays') || {};\nconst variables = ['temp', 'accX', 'accY', 'accZ', 'gyroX', 'gyroY', 'gyroZ', 'accAngleX', 'accAngleY'];\nvariables.forEach(v => {\n    if (!allDataArrays[v]) {\n        allDataArrays[v] = [];\n    }\n});\n\nfor (const readingString of individualReadingStrings) {\n    if (readingString.trim() === \"\") {\n        continue;\n    }\n\n    const dataArray = readingString.trim().split(\" \");\n\n    if (dataArray.length === NUM_VALUES_PER_READING) {\n        const imuObject = {\n            temp: parseFloat(dataArray[0]),\n            accX: parseFloat(dataArray[1]),\n            accY: parseFloat(dataArray[2]),\n            accZ: parseFloat(dataArray[3]),\n            gyroX: parseFloat(dataArray[4]),\n            gyroY: parseFloat(dataArray[5]),\n            gyroZ: parseFloat(dataArray[6]),\n            accAngleX: parseFloat(dataArray[7]),\n            accAngleY: parseFloat(dataArray[8])\n        };\n\n        variables.forEach(v => {\n            allDataArrays[v].push(imuObject[v]);\n        });\n        \n        messagesToSend.push({ payload: imuObject });\n    } else {\n        node.warn(`Leitura do IMU com número de valores inesperado: ${readingString}`);\n    }\n}\n\nvariables.forEach(v => {\n    if (allDataArrays[v].length > maxArraySize) {\n        allDataArrays[v].shift();\n    }\n});\n\nflow.set('allDataArrays', allDataArrays);\n\nfunction calculateVariance(data) {\n    if (!data || data.length < 2) {\n        return 0;\n    }\n    const mean = data.reduce((acc, val) => acc + val, 0) / data.length;\n    const sumOfSquares = data.reduce((acc, val) => acc + Math.pow(val - mean, 2), 0);\n    return sumOfSquares / (data.length - 1);\n}\n\nconst allVariances = {};\nvariables.forEach(v => {\n    allVariances[v] = calculateVariance(allDataArrays[v]);\n});\n\nconst lastMessage = messagesToSend[messagesToSend.length - 1];\nif (lastMessage) {\n    lastMessage.variances = allVariances;\n    lastMessage.id = ID;\n}\n\nmsg.topic = \"IMU\";\n\nreturn [lastMessage];",
