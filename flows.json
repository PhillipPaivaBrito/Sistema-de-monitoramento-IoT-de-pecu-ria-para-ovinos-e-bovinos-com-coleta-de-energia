    {
        "id": "6213541467bb78f4",
        "type": "function",
        "z": "41f05514e7e9b379",
        "name": "IMU data",
        "func": "\n// Assume que msg.payload contém a string completa com os separadores '^'\n// Ex: \"27.00 -0.05 ... 1.74^27.05 -0.05 ... 1.87^27.05 -0.05 ... 1.80\"\nconst fullImuDataString = msg.payload.trim();\n\n// Remove o prefixo \"GPS: \" se ele estiver presente\nconst cleanedGpsDataString = fullImuDataString.replace(\"IMU: \", \"\").trim();\n\n// Primeiro, divida a string pelas leituras de IMU usando o '\\n' como delimitador\nconst individualReadingStrings = fullImuDataString.split(\"\\n\");\n\nconst NUM_VALUES_PER_READING = 9; // 9 valores por cada leitura de IMU (temp, accX, etc.)\nvar messagesToSend = []; // Array para armazenar as mensagens que serão enviadas\n\n// Itera sobre cada string de leitura individual\nfor (const readingString of individualReadingStrings) {\n    if (readingString.trim() === \"\") {\n        // Ignora strings vazias que podem surgir de separadores extras\n        continue;\n    }\n\n    // Divide cada string de leitura em um array de números (usando espaço como delimitador)\n    const dataArray = readingString.trim().split(\" \");\n\n    // Verifica se temos o número correto de valores antes de processar\n    if (dataArray.length === NUM_VALUES_PER_READING) {\n        // Cria o objeto para esta leitura\n        const imuObject = {\n            temp: parseFloat(dataArray[0]),\n            accX: parseFloat(dataArray[1]),\n            accY: parseFloat(dataArray[2]),\n            accZ: parseFloat(dataArray[3]),\n            gyroX: parseFloat(dataArray[4]),\n            gyroY: parseFloat(dataArray[5]),\n            gyroZ: parseFloat(dataArray[6]),\n            accAngleX: parseFloat(dataArray[7]),\n            accAngleY: parseFloat(dataArray[8])//,\n            //accAngleZ: parseFloat(dataArray[9])\n        };\n\n        // Adiciona a nova mensagem (com o objeto IMU no payload) ao array de mensagens\n        messagesToSend.push({ payload: imuObject });\n    } else {\n        // Este warn é o que você está vendo agora, porque a string inteira está sendo passada para esta parte do código\n        node.warn(`Leitura do IMU com número de valores inesperado: ${readingString}`);\n    }\n}\nmsg.topic = \"IMU\"\n// Retorna um array de mensagens. O Node-RED enviará cada mensagem sequencialmente.\n// Isso fará com que o gráfico e os outros nós recebam cada leitura IMU individualmente.\nreturn [messagesToSend[0], messagesToSend[1], messagesToSend[2]];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 320,
        "wires": [
