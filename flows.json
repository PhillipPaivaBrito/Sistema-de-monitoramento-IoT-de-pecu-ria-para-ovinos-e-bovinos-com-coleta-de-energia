    {
        "id": "fc35075e473a8033",
        "type": "function",
        "z": "41f05514e7e9b379",
        "name": "gps data",
        "func": "// Assume que msg.payload contém a string \"0.000000 0.000000 0.00 0.00 0.00\"\nconst gpsDataString = msg.payload;\n\n// Remove o prefixo \"GPS: \" se ele estiver presente\nconst cleanedGpsDataString = gpsDataString.replace(\"GPS: \", \"\").trim();\n\n// Divide a string em um array de strings usando o espaço como delimitador\nconst dataArray = cleanedGpsDataString.split(\" \");\n\n// Converte os elementos do array para números e atribui a variáveis ou um objeto\nconst latitude = parseFloat(dataArray[0]);\nconst longitude = parseFloat(dataArray[1]);\nconst altitude = parseFloat(dataArray[2]);\nconst degree = parseFloat(dataArray[3]);\nconst speed = parseFloat(dataArray[4]);\n\nif(latitude!=0 && longitude!=0){\n    // Cria um novo objeto no payload com os dados separados\n    msg.payload = {\n        \"draggable\": false,\n        \"name\" : msg.id,\n        \"lat\": latitude,\n        \"lon\": longitude,\n        \"alt\":altitude,\n        \"icon\": \"locate\" ,\n        \"radius\":7,\n        \"color\":'#000000',\n        //\"opacity\":10,\n        \"fillColor\":'#3d00f5',\n        //\"fillOpacity\":10,\n        \"command\":{\n            \"zoon\":5,\n            \"lat\":latitude,\n            \"lon\":longitude\n        }\n    };\n    node.send([{ payload: msg.payload }, { payload: altitude }, { payload: speed }, { payload: degree }]);\n}",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
