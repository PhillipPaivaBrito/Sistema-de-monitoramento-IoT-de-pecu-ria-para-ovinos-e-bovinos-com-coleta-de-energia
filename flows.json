        "name": "thresholds",
        "func": "const variances = msg.variances;\nconst ID = msg.id;\n\n// Defina os limites de variância para cada variável.\n// Você pode ajustar esses valores conforme necessário.\nconst thresholds = {\n    temp: 10.005,\n    accX: 1.505,\n    accY: 1.505,\n    accZ: 2.005,\n    gyroX: 30000.05,\n    gyroY: 30000.05,\n    gyroZ: 30000.05,\n    accAngleX: 100.005,\n    accAngleY: 100.005\n};\n\nlet alertMessages = [];\n\n// Itera sobre cada variável e verifica se a variância está acima do limite\nfor (const key in variances) {\n    if (variances.hasOwnProperty(key) && variances[key] > thresholds[key]) {\n        alertMessages.push(` - ${key}: ${variances[key].toFixed(4)}`);\n    }\n}\n\n// Se alguma variância estiver alta, constrói a mensagem de alerta\nif (alertMessages.length > 0) {\n    // Adiciona o ID no início da mensagem\n    msg.payload = `Dispositivo ${ID} - Alta Variância Detectada:\\n${alertMessages.join('\\n')}`;\n    return msg;\n}\n\n// Se nenhuma variância estiver alta, não envia nada\nreturn null;",
